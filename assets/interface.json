        {
            "name": "🏛️ 公会签到",
            "entry": "公会签到开始",
            "default_check": true,
            "doc": "进入公会完成每日签到。",
            "label": "🏛️ 公会签到"
        },
        {
            "name": "⚔️ 刷体力 - 英雄传",
            "entry": "每日体力开始",
            "default_check": true,
            "option": [
                "刷取目标-英雄传"
