            "option": [
                "启动方式"
            ],
            "doc": "启动游戏并回到游戏主界面。",
            "label": "🎮 启动游戏"
        },
        {
            "name": "📧 领取邮箱",
            "entry": "领取邮箱开始",
            "default_check": true,
            "doc": "进入邮箱领取全部邮件奖励。",
            "label": "📧 领取邮箱"
        },
        {
            "name": "🤝 好友赠送",
            "entry": "好友赠送开始",
            "default_check": true,
            "doc": "进入好友界面，一键赠送好友礼物并领取。",
            "label": "🤝 好友赠送"
        },
        {
            "name": "🛒 每日商店",
            "entry": "每日商店开始",
            "default_check": true,
